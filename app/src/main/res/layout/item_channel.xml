<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginBottom="6dp" android:orientation="horizontal"
    android:background="@drawable/focus_background" android:focusable="true" android:clickable="true" android:gravity="center_vertical" android:padding="10dp">
    <TextView android:id="@+id/channelNumber" android:layout_width="26dp" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/text_secondary"/>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/channelName" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:textColor="@color/text_primary" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/channelBadge" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/accent" android:maxLines="1" android:ellipsize="end"/>
    </LinearLayout>
</LinearLayout>
