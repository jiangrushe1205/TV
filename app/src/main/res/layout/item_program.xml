<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="62dp" android:layout_marginBottom="6dp"
    android:orientation="vertical" android:padding="9dp" android:background="@drawable/focus_background" android:focusable="true">
    <TextView android:id="@+id/programTime" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/accent" android:textSize="12sp"/>
    <TextView android:id="@+id/programName" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/text_primary" android:textSize="14sp" android:maxLines="3" android:ellipsize="end"/>
</LinearLayout>
