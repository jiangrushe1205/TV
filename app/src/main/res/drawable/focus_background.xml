<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="#304C43"/><stroke android:width="2dp" android:color="@color/accent"/><corners android:radius="4dp"/></shape>
    </item>
    <item android:state_selected="true">
        <shape><solid android:color="#253D34"/><stroke android:width="1dp" android:color="#40725E"/><corners android:radius="4dp"/></shape>
    </item>
    <item><shape><solid android:color="@color/surface_raised"/><corners android:radius="4dp"/></shape></item>
</selector>
